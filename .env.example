# Soorin Data Privacy Gateway environment template.
# Copy to .env, set secrets locally, chmod 600 .env; NEVER commit .env.
# Intentionally fail-closed: blank master key + empty client list MUST be configured before startup.
# For a throwaway dev-only setup instead: python3 scripts/init_dev_env.py (refuses overwrite).
#
# Base64 of exactly 32 RANDOM bytes. Do not paste this value in chats or logs.
# Keep existing keys while you need to decrypt existing Redis contexts; plan rotation.
DLP_MASTER_KEY_B64=
#
# JSON array of service clients. Generate a separate long random key per product.
# Gateway stores SHA-256 hex digests; the calling product stores the plaintext API key.
# Example client (do NOT use placeholders literally):
# [{"client_id":"agentic-soc","key_sha256":"<64_HEX_DIGEST>","tenants":["<CANONICAL_TENANT_UUID>"],"allow_tenantless":false,"allow_secret_decode":false}]
DLP_CLIENTS_JSON=[]
#
# Production-style defaults: the demo key and demo browser UI are DISABLED.
DLP_DEV_MODE=false
DLP_UI_ENABLED=false
DLP_DEMO_API_KEY=
#
# Native run: redis://localhost:6379/0 requires a local Redis instance.
# docker-compose.yml OVERRIDES the backend to redis://redis:6379/0.
# Use authenticated rediss:// with private networking for production.
DLP_STORE_BACKEND=redis
DLP_REDIS_URL=redis://localhost:6379/0
#
# In Docker, compose sets DLP_PROFILE_DIR=/opt/dlp/profiles.
# Leave unset for native execution so the app resolves its repository profiles/.
# DLP_PROFILE_DIR=/opt/dlp/profiles
DLP_CONTEXT_TTL=3600
DLP_MAX_CONTEXT_TTL=86400
DLP_MAX_ENTRIES=1000000
DLP_MAX_PAYLOAD_BYTES=67108864
#
# Used only in dev mode. Never set a wildcard CORS origin for the demo UI.
# DLP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
