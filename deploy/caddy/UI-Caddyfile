{
    admin off
    auto_https disable_redirects
    default_sni {$DLP_UI_LAN_BIND_IP}
}

# Demo UI only. Without Basic Auth all reachable LAN/VPN clients can obtain
# the demo-only token via /v1/dev/console. NEVER attach to production Redis.
https://{$DLP_UI_LAN_BIND_IP}:8443 {
    tls internal
    reverse_proxy privacy-ui-test:8484
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Cache-Control "no-store"
    }
}
